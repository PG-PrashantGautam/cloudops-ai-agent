# Choose default provider: "ollama" (free/local) or "bedrock" (AWS)
LLM_PROVIDER=ollama

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=llama3.2
OLLAMA_SPECIALIST_MODEL=qwen2.5-coder:3b

# Optional AWS Bedrock settings (if using --provider bedrock)
AWS_REGION=us-east-1
BEDROCK_ROUTER_MODEL=amazon.nova-micro-v1:0
BEDROCK_SPECIALIST_MODEL=amazon.nova-lite-v1:0
